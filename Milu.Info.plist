<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud sync: CloudKit wakes the app with a silent push when another device changes the data. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Export compliance: only Apple's own encryption (HTTPS to Milu's server, iCloud), which is
	     exempt; TestFlight and the App Store then ask nothing for each build (2026-11-14). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Milu's splash (`SplashScene`), its sky and garden filling the screen at launch, light and dark. -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
</dict>
</plist>
