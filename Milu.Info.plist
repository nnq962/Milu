<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud sync: CloudKit wakes the app with a silent push when another device changes the data. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Export compliance: only Apple's own encryption (HTTPS to Milu's server, iCloud), which is
	     exempt; TestFlight and the App Store then ask nothing for each build (2026-11-14). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Milu's splash (`SplashScene`), its sky and garden filling the screen at launch, light and dark. -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!-- The app is in Vietnamese: iOS's own buttons and menus in it are too ("Huỷ", "Sao chép"),
	     and the App Store lists Tiếng Việt (audit round 3, 2026-11-16: both were English). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>vi</string>
	</array>
	<!-- The widget's buttons open the app with milu://add (Thêm giao dịch) and milu://ai (Thêm
	     bằng AI), see `WidgetShared`. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>milu</string>
			</array>
		</dict>
	</array>
	<!-- The folder shared with the widget (`WidgetShared`), per build: Milu Dev has its own. -->
	<key>MiluAppGroup</key>
	<string>$(APP_GROUP_ID)</string>
	<!-- The app's own animations at the screen's rate (120 Hz on ProMotion iPhones), as the
	     keyboard and iOS's sheets: without it they run at 60 and lag beside them (user report
	     2026-11-19, "giật giật ở màn 120hz"). -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
</dict>
</plist>
